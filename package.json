{
  "name": "geo-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:vercel": "prisma generate && prisma migrate deploy && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:scorehero": "vitest run --config vitest.verify.config.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sparticuz/chromium-min": "149.0.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.33.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "puppeteer-core": "25.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "30.0.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prisma": "7.9.1",
    "puppeteer": "25.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
