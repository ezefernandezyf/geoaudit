# Relevy — environment template (copy to .env and fill real values)
# NEVER commit real secrets. All values below are placeholders.

# --- App URL (public) ---
# Canonical site origin used for sitemap, robots, JSON-LD and OG metadata
# (src/app/{sitemap,robots,page,layout}.ts). In production this MUST be
# https://relevy.app (set it in Vercel, not in .env).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Prisma 7 + @prisma/adapter-pg, PostgreSQL/Supabase) ---
# Connection string of your Supabase PostgreSQL instance.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# --- Auth (NextAuth v5 / Auth.js, GitHub OAuth) ---
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"
# Canonical origin for auth callbacks (NextAuth v5 legacy alias). Vercel sets
# it in production; keep localhost for local development.
NEXTAUTH_URL="http://localhost:3000"

# --- Rate limiting (free audit flow) ---
# Fixed-window limiter (5 req / 60s per client key, RTL-1). Dev/test usan el
# store in-memory; producción usa el store DB-backed (tabla rateLimitEntry,
# compartido entre instancias serverless, RTL-6). El client key se resuelve de
# x-forwarded-for / x-real-ip (headers estándar de Vercel/Cloudflare). Set to
# "false" to disable entirely — emergency kill switch (RTL-7).
RATE_LIMIT_ENABLED="true"
