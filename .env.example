# GeoAudit — environment template (copy to .env and fill real values)
# NEVER commit real secrets. All values below are placeholders.

# --- Database (Prisma 7 + @prisma/adapter-pg, PostgreSQL/Supabase) ---
# Connection string of your Supabase PostgreSQL instance.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# --- Auth (NextAuth v5 / Auth.js, GitHub OAuth) ---
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# --- Stripe (test mode) ---
# https://dashboard.stripe.com/test/apikeys — see docs/stripe-test-setup.md
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# --- Rate limiting (free audit flow) ---
# In-memory fixed-window limiter inside the audit Server Action (5 req / 60s
# per client key). Best-effort per instance in serverless (no shared state
# across instances; DB-backed limiter lands in Sprint 3). Set to "false" to
# disable entirely — emergency kill switch.
RATE_LIMIT_ENABLED="true"
